# ============================================================================
# VedaApex Redis Chat Memory - Environment Configuration
# ============================================================================
#
# Redis Configuration for Conversation Memory
# This enables fast in-memory storage of chat conversations with fallback to database
#

# ─── Redis Connection ──────────────────────────────────────────────────────────
# Redis URL for chat memory storage
# Format: redis://[:password]@host[:port][/db]
# 
# Examples:
#   Local development (no auth):
#     REDIS_URL=redis://localhost:6379/0
#   
#   Local with auth:
#     REDIS_URL=redis://:yourpassword@localhost:6379/0
#   
#   Remote Redis (e.g., Redis Cloud):
#     REDIS_URL=redis://:your-api-key@redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com:12345/0
#   
#   Using connection string from provider (common pattern):
#     REDIS_URL=redis://default:password@host:port
#
# IMPORTANT:
#   - Do not commit this file with actual credentials
#   - Use environment variables for secrets in production
#   - Keep credentials secure; rotate them regularly
#
# If not set:
#   - Chat memory uses only the database (slower but works)
#   - All conversations are still saved permanently in PostgreSQL
#   - No Redis errors will break the application
#
REDIS_URL=redis://localhost:6379/0

# ─── Redis Chat Memory Settings ────────────────────────────────────────────────

# TTL (Time-To-Live) for cached chat messages in seconds
# Default: 2592000 (30 days)
# 
# After this period, the Redis cache is automatically cleared
# Note: Database records are NOT deleted (they persist forever)
# Redis is just a fast memory layer; permanent storage is the database
#
# Examples:
#   30 days:   2592000
#   7 days:    604800
#   24 hours:  86400
#   1 hour:    3600
#
REDIS_CHAT_TTL=2592000

# ─── Context Window Management ────────────────────────────────────────────────

# Number of recent messages to keep in fast memory
# Default: 50
#
# When retrieving context for AI, this controls how many recent messages
# are included before the model. Older messages are summarized.
#
# Lower values = faster retrieval, less context
# Higher values = slower retrieval, more context
#
# Recommendations:
#   - Small models (< 7B params):  20-30
#   - Medium models (7B-30B):      30-50
#   - Large models (30B+):         50-100
#
REDIS_CHAT_CONTEXT_LIMIT=50

# ─── Token Threshold for Summarization ─────────────────────────────────────────

# Token count threshold before triggering conversation summarization
# Default: 5000
#
# When a conversation approaches this token count, older messages are summarized
# to maintain context while keeping token usage reasonable.
#
# How it works:
#   1. Count tokens in recent messages
#   2. If approaching threshold, summarize older messages
#   3. Include summary in AI context instead of raw messages
#   4. Keeps context rich while managing token budget
#
# Adjust based on your model's token limits:
#   - GPT-3.5 (4k context):    4000
#   - GPT-4 (8k context):      7000
#   - Claude (100k context):   80000
#   - Mistral (32k context):   25000
#
REDIS_CHAT_SUMMARY_TOKEN_THRESHOLD=5000

# ============================================================================
# Production Deployment Notes
# ============================================================================
#
# 1. Redis Deployment Options:
#    - Redis Cloud (recommended for SaaS)
#    - AWS ElastiCache
#    - Azure Cache for Redis
#    - Self-managed Redis on VM/container
#    - Docker Compose (for staging/dev)
#
# 2. High Availability:
#    - Use Redis Cluster or Sentinel for production
#    - Configure replication and failover
#    - Monitor Redis memory and performance
#
# 3. Security:
#    - Always use authentication (password)
#    - Encrypt connections with TLS/SSL
#    - Restrict network access (VPC/security groups)
#    - Rotate credentials regularly
#    - Never log Redis URL with credentials
#
# 4. Backup & Recovery:
#    - Enable Redis persistence (RDB snapshots)
#    - Regular backups to S3/cloud storage
#    - Test restore procedures
#    - Database is permanent source of truth (always backed up)
#
# 5. Performance Tuning:
#    - Monitor maxmemory usage
#    - Set eviction policy (LRU recommended)
#    - Use connection pooling
#    - Monitor latency and throughput
#
# 6. Monitoring & Alerting:
#    - Alert on Redis connection failures
#    - Monitor memory usage
#    - Track cache hit/miss rates
#    - Alert if Redis is down for > 5 min
#
# 7. Graceful Degradation:
#    - Application continues working without Redis
#    - Chat memory falls back to database
#    - No user-facing errors
#    - Slower responses but still functional
#    - Monitor logs for Redis issues
#
# ============================================================================
