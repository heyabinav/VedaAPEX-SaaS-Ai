# Application
APP_NAME=VedaApex Search Aggregation
APP_VERSION=1.0.0
APP_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database
# Local dev: keep SQLite or point this at your Supabase Postgres URL.
DATABASE_URL=sqlite:///./vedaapex.db
# Supabase Postgres example:
# DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# API Keys
PEXELS_API_KEY=your_pexels_key_here
NASA_API_KEY=DEMO_KEY
WIKIMEDIA_API_KEY=

# Razorpay Payment Settings
RAZORPAY_KEY_ID="rzp_live_T3WW3Rw0QCj8yB"
RAZORPAY_KEY_SECRET="BRyOowPer1iLzYJWI3BhPcWi"
RAZORPAY_CURRENCY="INR"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Provider Settings
ENABLE_PEXELS=true
ENABLE_WIKIMEDIA=true
ENABLE_NASA=true

# Cache Settings
CACHE_ENABLED=true
CACHE_TYPE=memory
CACHE_TTL=3600
REDIS_URL=redis://localhost:6379/0

# Request Settings
REQUEST_TIMEOUT=15
MAX_RESULTS=50
DEFAULT_PAGE_SIZE=20

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Query Settings
MIN_QUERY_LENGTH=2
MAX_QUERY_LENGTH=200

# CORS
CORS_ORIGINS=["*"]

# App URLs (OAuth callback + frontend redirect targets)
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Custom MCP Connectors
MCP_ENCRYPTION_KEY=
MCP_OAUTH_CALLBACK_URL=http://localhost:8000/api/v1/mcp/oauth/callback
MCP_CONNECTION_TIMEOUT_SECONDS=30
MCP_TOOL_TIMEOUT_SECONDS=60
MCP_MAX_RESPONSE_BYTES=10485760
MCP_MAX_REDIRECTS=3
MCP_ALLOW_HTTP_LOCAL_DEV=false

# Hugging Face Dataset Storage (Persistent User Skills)
HF_TOKEN=
HF_STORAGE_REPO_ID=vedaapex/chat-storage
HF_STORAGE_REPO_TYPE=dataset
HF_STORAGE_TIMEOUT_SECONDS=30
HF_STORAGE_MAX_RETRIES=3

# OAuth (Figma / Canva)
OAUTH_TOKEN_ENCRYPTION_KEY=change-me-to-a-32-byte-fernet-key
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret
FIGMA_REDIRECT_URI=http://localhost:8000/api/v1/figma/callback
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
CANVA_REDIRECT_URI=http://localhost:8000/api/v1/canva/callback
